{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/roomci/scenario.schema.json",
  "title": "roomci scenario",
  "type": "object",
  "required": ["version", "scenario", "room"],
  "properties": {
    "version": { "type": "string" },
    "scenario": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "clock": { "type": "object" }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "devices"],
      "properties": {
        "id": { "type": "string" },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "initial_state": { "type": "object" }
            }
          }
        }
      }
    },
    "steps": { "type": "array" },
    "assertions": { "type": "array" }
  }
}
